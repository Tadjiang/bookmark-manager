# 本地开发使用 SQLite 文件（相对 prisma7.config.ts 所在目录解析）
DATABASE_URL="file:./dev.db"

# ---------- Auth.js（NextAuth v5） ----------
# 会话 / JWT 的签名密钥，必填。生成方式：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# GitHub OAuth：在 https://github.com/settings/developers 新建 OAuth App，
# Authorization callback URL 填 http://localhost:3000/api/auth/callback/github
# 两个变量都配齐才会显示 GitHub 登录按钮；留空则只保留邮箱+密码登录。
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# 本地 / 自建部署时信任请求的 Host 头（Vercel 上不需要）
AUTH_TRUST_HOST="true"

# ---------- 远端数据库（Turso / 远端 libSQL） ----------
#
# 只在本地跑「对远端的运维命令」时用，两处用途刻意分开：
#
#   · 应用本身读 DATABASE_URL / DATABASE_AUTH_TOKEN
#     —— 本地是 file:./dev.db，Vercel 上是 libsql://... ；
#   · 远端运维脚本（db:migrate:remote / db:verify:remote）读下面这两个 REMOTE_*
#
# 不要把 Turso 地址写进本地的 DATABASE_URL：那样 `npm run dev` 会直接读写线上数据，
# 而且 `prisma migrate dev` / `prisma studio` 会因为 CLI 不认 libsql:// 而失效（P1013）。
#
# REMOTE_DATABASE_URL="libsql://<数据库名>-<组织名>.turso.io"
# REMOTE_DATABASE_AUTH_TOKEN="<在 Turso 控制台生成的 token>"
#
# 用 Turso CLI 的话，这两个值可以用下面两条命令直接打印出来：
#   turso db show <数据库名> --url
#   turso db tokens create <数据库名>
