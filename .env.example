# 本地开发使用 SQLite 文件（相对 prisma7.config.ts 所在目录解析）
DATABASE_URL="file:./dev.db"

# ---------- Auth.js（NextAuth v5） ----------
# 会话 / JWT 的签名密钥，必填。生成方式：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# GitHub OAuth：在 https://github.com/settings/developers 新建 OAuth App，
# Authorization callback URL 填 http://localhost:3000/api/auth/callback/github
# 两个变量都配齐才会显示 GitHub 登录按钮；留空则只保留邮箱+密码登录。
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# 本地 / 自建部署时信任请求的 Host 头（Vercel 上不需要）
AUTH_TRUST_HOST="true"

# 线上换成远端 libSQL（如 Turso）时，把上面一行换成下面两行：
# DATABASE_URL="libsql://<数据库名>-<组织名>.turso.io"
# DATABASE_AUTH_TOKEN="<在 Turso 控制台生成的 token>"
